    SELECT TOP(1) [o].[OrderId], [o].[CreatedAt], [o].[CustomerId], [o].[DeliveryDate], [o].[IsDelivered], [o].[IsPaid], [o].[OrderDate], [o].[OrderStatus], [o].[PaymentId], [o].[ShippingAddress], [o].[TotalAmount], [o].[UpdatedAt]
    FROM [Orders] AS [o]
    WHERE [o].[OrderId] = @__request_OrderId_0
) AS [t]
LEFT JOIN (
    SELECT [o0].[OrderItemId], [o0].[CreatedAt], [o0].[OrderId], [o0].[ProductId], [o0].[Quantity], [o0].[UnitPrice], [o0].[UpdatedAt], [p].[ProductId] AS [ProductId0], [p].[Category], [p].[CreatedAt] AS [CreatedAt0], [p].[Description], [p].[IsDeleted], [p].[Name], [p].[Price], [p].[Quantity] AS [Quantity0], [p].[SellerId], [p].[UpdatedAt] AS [UpdatedAt0], [p].[UserId]
