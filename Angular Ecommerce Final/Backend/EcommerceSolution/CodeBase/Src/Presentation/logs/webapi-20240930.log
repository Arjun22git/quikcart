        ShippingAddress = o.ShippingAddress, 
        OrderItems = o.OrderItems
            .Select(oi => new OrderItemDto{ 
                ProductId = oi.ProductId, 
                ProductName = oi.Product.Name, 
                Quantity = oi.Quantity 
            }
            )
            .ToList() 
    }
